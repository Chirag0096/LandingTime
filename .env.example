# ==========================================
# Landing Time - Environment Configuration
# ==========================================

# Google Gemini API Key (Optional for basic demo, recommended for full dynamic AI features)
# Landing Time uses the ₹0 Free Tier (15 RPM, 1500 RPD).
# If omitted or offline, the system seamlessly falls back to pre-compiled culinary catalogs.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Backend & MCP Streamable HTTP Port
PORT=3001
NODE_ENV=development
